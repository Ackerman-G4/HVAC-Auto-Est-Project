rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function isProjectOwner(projectId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // ── Users Collection ────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── Projects (owner-scoped) ─────────────────────────────
    match /projects/{projectId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Ownership is immutable from the client.
      //
      // The previous rule checked only resource.data.ownerId -- the document as
      // it already exists -- and never constrained the incoming value, so an
      // owner could write a different id and transfer the record, or write a
      // nonexistent one and orphan it beyond their own reach.
      //
      // Transferring ownership, if it becomes a feature, is a privileged server
      // operation through the Admin SDK, not a client write.
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Sub-collections inherit project ownership
      match /floors/{floorId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
      match /rooms/{roomId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
      match /selectedEquipment/{selectionId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
      match /boqItems/{itemId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }

      // Simulation cases (project-scoped)
      match /simulationCases/{caseId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;

        // Run jobs per case
        match /runJobs/{jobId} {
          allow read, write: if isAuthenticated()
            && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        }

        // Artifact manifests per case
        match /artifacts/{artifactId} {
          allow read, write: if isAuthenticated()
            && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        }
      }

      // Simulation layout (floorplan HVAC/tile placements)
      match /simulationLayouts/{layoutId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }

    // ── Project child collections (top-level, projectId FK) ─
    match /floors/{floorId} {
      allow read, update, delete: if isAdmin() || isProjectOwner(resource.data.projectId);
      allow create: if isAdmin() || isProjectOwner(request.resource.data.projectId);
    }
    match /rooms/{roomId} {
      allow read, update, delete: if isAdmin() || isProjectOwner(resource.data.projectId);
      allow create: if isAdmin() || isProjectOwner(request.resource.data.projectId);
    }
    match /selectedEquipment/{selectionId} {
      allow read, update, delete: if isAdmin() || isProjectOwner(resource.data.projectId);
      allow create: if isAdmin() || isProjectOwner(request.resource.data.projectId);
    }
    match /boqItems/{itemId} {
      allow read, update, delete: if isAdmin() || isProjectOwner(resource.data.projectId);
      allow create: if isAdmin() || isProjectOwner(request.resource.data.projectId);
    }

    // ── Login Events (admin-read, server-write only) ────────
    match /loginEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ── Price Audit Logs (admin-read, server-write only) ────
    match /priceAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Price Overrides (authenticated-read, server-write only)
    match /priceOverrides/{overrideId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── BOQ Snapshots (project-owner read, server-write only)
    match /boqSnapshots/{snapshotId} {
      allow read: if isAdmin() || isProjectOwner(resource.data.projectId);
      allow write: if false;
    }

    // ── Simulations (owner-scoped) ──────────────────────────
    match /simulations/{simId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Ownership is immutable from the client.
      //
      // The previous rule checked only resource.data.ownerId -- the document as
      // it already exists -- and never constrained the incoming value, so an
      // owner could write a different id and transfer the record, or write a
      // nonexistent one and orphan it beyond their own reach.
      //
      // Transferring ownership, if it becomes a feature, is a privileged server
      // operation through the Admin SDK, not a client write.
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ── Rules Engine (admin-write, authenticated-read) ──────
    match /rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Materials & Suppliers (admin-write, authenticated-read)
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── App Settings (admin-write, authenticated-read) ──────
    match /appSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Diagnostics (owner-scoped) ──────────────────────────
    match /diagnosticHistory/{diagId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Ownership is immutable from the client.
      //
      // The previous rule checked only resource.data.ownerId -- the document as
      // it already exists -- and never constrained the incoming value, so an
      // owner could write a different id and transfer the record, or write a
      // nonexistent one and orphan it beyond their own reach.
      //
      // Transferring ownership, if it becomes a feature, is a privileged server
      // operation through the Admin SDK, not a client write.
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ── Audit Logs (append-only for authenticated, read for admin)
    match /auditLogs/{logId} {
      allow read: if isAdmin();

      // No client writes of any kind.
      //
      // `allow create: if isAuthenticated()` let any signed-in caller append an
      // arbitrary entry, including one attributed to somebody else. An
      // append-only log that anyone can append to has no evidentiary value --
      // worse than none, because its existence invites trust.
      //
      // Entries are written by audit-log-store.ts through the Admin SDK, which
      // bypasses rules entirely, so denying the client changes no behaviour in
      // this application. Matches how loginEvents and priceAuditLogs are
      // already handled.
      allow write: if false;
    }

    // ── Terminal deny ───────────────────────────────────────
    //
    // Firestore already denies anything unmatched, so this changes no
    // behaviour. It states the default in the file, where a reviewer adding a
    // collection can see it, rather than leaving it as knowledge someone has
    // to bring with them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
